# scripts/*.sh が読む環境設定。このファイルを server/env.local にコピーして、書き換える (env.local は git に入れない)

# 研究のリポジトリ (anticloning_mask を含む場所)。最適化の本体を import する。このリポジトリには含めない
ANTICLONING_MASK_ROOT=/path/to/AntiCloning_mask

# Python (PyTorch、speechbrain、soundfile が入っているもの)
PYTHON=/path/to/venv/bin/python

# 重みの置き場 (ネットに取りに行かないので、あらかじめ置く)
#   x-vector (speechbrain/spkrec-xvect-voxceleb): HF_HOME の下の hub/ に置く
#   UTMOS (tarepan/SpeechMOS v1.2.0): TORCH_HUB_DIR の下に、tarepan_SpeechMOS_v1.2.0/ と checkpoints/utmos22_strong_step7459_v1.pt
HF_HOME=/path/to/hf
TORCH_HUB_DIR=/path/to/torch_hub

# ターゲット話者の候補群を作るときだけ使う: LibriTTS (Hugging Face の mythicinfinity/libritts) の parquet があるフォルダと、
# pyarrow を含むフォルダ (PYTHON に pyarrow が入っていれば、PYARROW_PATH は要らない)
LIBRITTS_PARQUET_DIR=/path/to/libritts/data
PYARROW_PATH=/path/to/site-packages_with_pyarrow
