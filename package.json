{
  "name": "voice-privacy-protection-site",
  "private": true,
  "type": "module",
  "description": "「研究のシナリオ」と「デモ」のタブの本文 (content/*.mdx) を HTML に変換する。サイトの配信には使わない",
  "scripts": {
    "build": "node tools/scenario/build.mjs",
    "check": "node tools/scenario/build.mjs --check",
    "build:scenario": "node tools/scenario/build.mjs --only scenario",
    "check:scenario": "node tools/scenario/build.mjs --check --only scenario",
    "build:demo": "node tools/scenario/build.mjs --only demo",
    "check:demo": "node tools/scenario/build.mjs --check --only demo"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "preact": "10.29.8",
    "preact-render-to-string": "6.8.3"
  }
}
